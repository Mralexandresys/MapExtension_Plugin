{
    "name": "mapview",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "pnpm@10.14.0",
    "engines": {
        "node": "^20.19.0 || >=22.12.0",
        "pnpm": "10.14.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && node -e \"require('node:fs').renameSync('dist/index.html', 'dist/MapExtensionViewer.html')\"",
        "preview": "vite preview",
        "check": "vue-tsc --noEmit",
        "mock-api": "python3 local-test/mock_server.py"
    },
    "dependencies": {
        "vue": "^3.5.41"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.8",
        "typescript": "^5.9.3",
        "vite": "^7.3.6",
        "vite-plugin-singlefile": "^2.3.3",
        "vue-tsc": "^3.3.9"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}
